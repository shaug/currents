{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Currents private household inventory v1",
  "$comment": "Intake only, never activation. Runtime additionally requires a bijection of manifest/component/coverage IDs; text bounds use UTF-8 bytes; confirmed automatic_required is yes/no. Confirmed text is an answer, not a semantic validation or approval token.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "enum": [
        "synthetic",
        "actual_household"
      ]
    },
    "inventory_manifest": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "kind": {
            "enum": [
              "cash",
              "card",
              "debt",
              "investment",
              "manual_asset",
              "manual_liability",
              "apple_card",
              "unknown"
            ]
          },
          "institution": {
            "$ref": "#/$defs/answer"
          },
          "account": {
            "$ref": "#/$defs/answer"
          },
          "currencies": {
            "$ref": "#/$defs/answer"
          },
          "ownership": {
            "$ref": "#/$defs/answer"
          },
          "overlaps": {
            "$ref": "#/$defs/answer"
          },
          "exports": {
            "$ref": "#/$defs/answer"
          },
          "automatic_required": {
            "$ref": "#/$defs/answer"
          },
          "opening": {
            "$ref": "#/$defs/answer"
          },
          "inclusion": {
            "$ref": "#/$defs/answer"
          }
        },
        "required": [
          "id",
          "kind"
        ]
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "component_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "route": {
            "enum": [
              "automatic",
              "file",
              "manual",
              "unknown"
            ]
          },
          "limitation": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "const": "unassessed"
                  }
                },
                "required": [
                  "status"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "const": "owner_accepted"
                  },
                  "detail": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "status",
                  "detail"
                ]
              }
            ]
          }
        },
        "required": [
          "component_id",
          "route",
          "limitation"
        ]
      }
    },
    "meaning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "$ref": "#/$defs/answer"
        },
        "reporting_currency": {
          "$ref": "#/$defs/answer"
        },
        "source_precedence": {
          "$ref": "#/$defs/answer"
        },
        "freshness_threshold": {
          "$ref": "#/$defs/answer"
        },
        "withholding": {
          "$ref": "#/$defs/answer"
        },
        "commitments": {
          "$ref": "#/$defs/answer"
        }
      },
      "required": []
    }
  },
  "required": [
    "schema_version",
    "profile",
    "inventory_manifest",
    "components",
    "coverage",
    "meaning"
  ],
  "$defs": {
    "answer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "unknown",
                "conflict",
                "not_assessed",
                "unresolved"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value"
          ],
          "properties": {
            "status": {
              "const": "confirmed"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            }
          }
        }
      ]
    }
  }
}
