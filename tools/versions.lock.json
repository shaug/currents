  "kernel": {
    "source": "https://raw.githubusercontent.com/hupe1980/doubleentry/3c514c97169a98d96f0668e6addfd92e1e8f6f69/Cargo.toml",
    "commit": "3c514c97169a98d96f0668e6addfd92e1e8f6f69",
    "manifest_sha256": "0ea037bbdd701554282ef42d80da736d7aebe5b370064799d3a55fecd5427fd8",
    "package": {
      "name": "doubleentry",
      "version": "0.9.0",
      "edition": "2024",
      "rust-version": "1.94",
      "authors": [
        "hupe1980"
      ],
      "description": "An immutable, tamper-evident double-entry bookkeeping engine: one pure rule core, exact integer money, identity derived from the idempotency key, and one append-only RFC 6962 Merkle log with inclusion, consistency and sealed-balance proofs and C2SP checkpoints, in memory (sync) or over SQLite and PostgreSQL (async).",
      "keywords": [
        "accounting",
        "ledger",
        "double-entry",
        "bookkeeping",
        "merkle"
      ],
      "categories": [
        "finance",
        "data-structures",
        "cryptography"
      ],
      "license": "MIT OR Apache-2.0",
      "repository": "https://github.com/hupe1980/doubleentry",
      "homepage": "https://hupe1980.github.io/doubleentry",
      "documentation": "https://docs.rs/doubleentry",
      "readme": "README.md",
      "include": [
        "src/**",
        "tests/**",
        "examples/**",
        "benches/**",
        "/README.md",
        "/CHANGELOG.md",
        "/LICENSE-APACHE",
        "/LICENSE-MIT"
      ],
      "metadata": {
        "docs": {
          "rs": {
            "all-features": true,
            "rustdoc-args": [
              "--cfg",
              "docsrs"
            ]
          }
        }
      }
    },
    "features": {
      "default": [],
      "serde": [
        "dep:serde",
        "time/serde"
      ],
      "postgres": [
        "dep:sqlx",
        "sqlx/postgres"
      ],
      "postgres-tls": [
        "postgres",
        "sqlx/tls-rustls-aws-lc-rs"
      ],
      "sqlite": [
        "dep:sqlx",
        "sqlx/sqlite-bundled",
        "sqlx/sqlite-unlock-notify"
      ],
      "witness": [
        "dep:ed25519-dalek"
      ],
      "testing": [
        "dep:tokio"
      ],
      "tracing": [
        "dep:tracing"
      ]
    },
